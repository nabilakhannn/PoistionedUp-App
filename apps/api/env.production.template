# ═══════════════════════════════════════════════════════════
# PositionedUp API — Production Environment Variables
# ═══════════════════════════════════════════════════════════
# Set these in Railway/Render dashboard or as Docker env vars.
# Do NOT commit real values to Git.

# ── Supabase (required) ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── LLM (required) ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Search (optional, improves quality) ────────────────────
TAVILY_API_KEY=tvly-...

# ── CORS (required: comma-separated JSON array) ───────────
# Include your Vercel frontend URL + localhost for development
CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]

# ── LangGraph (required for content pipeline worker) ──────
LANGGRAPH_DB_URI=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── OAuth (optional, for Google Docs / Notion export) ─────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth redirect URI is auto-derived: CORS_ORIGINS[0]/oauth/google/callback
# Make sure the first CORS origin is your production frontend URL.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://your-backend.up.railway.app/oauth/notion/callback
# ^ Must match what you registered in Notion's integration settings

# ── Cost Governance ──────────────────────────────────────
MAX_TOKENS_PER_STEP=32000
MAX_TOKENS_PER_WORKFLOW=200000
MAX_WORKFLOWS_PER_USER_PER_DAY=10

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
