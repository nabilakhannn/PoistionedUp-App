{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowPlan",
  "description": "Schema for workflow execution plan generated by planner",
  "type": "object",
  "properties": {
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["research", "generation", "editing", "testing", "interrupt"] }
        },
        "required": ["id", "name", "type"]
      }
    }
  },
  "required": ["steps"]
}
