# ─────────────────────────────────────────────────────────
# PositionedUp — Complete Environment Variables Reference
# Copy to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
# SECTION A: VPS Environment (OpenClaw Gateway + Agents)
# Set these on your Hostinger VPS in ~/openclaw/.env
# ═══════════════════════════════════════════════════════════

# ── OpenClaw Gateway ─────────────────────────────────────
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── LLM Provider Keys ────────────────────────────────────
# OpenAI (used by Jumbo, Trend Analyzer, Visual Designer, Distributor, Analytics)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (used by Copywriter for Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Telegram Bot ──────────────────────────────────────────
# Get from @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Your Telegram user ID (numeric). Get from @userinfobot or gateway logs
TELEGRAM_OWNER_CHAT_ID=123456789

# ── PositionedUp Brain Connection ─────────────────────────
# Agent Bridge API key (must match AGENT_API_KEY in Vercel backend)
AGENT_API_KEY=your-agent-bridge-api-key

# PositionedUp backend URL (your deployed API)
POSITIONEDUP_API_URL=https://your-deployed-api-url.vercel.app

# Your Supabase user ID (for Agent Bridge X-User-Id header)
POSITIONEDUP_USER_ID=your-supabase-user-id

# ── PostHog Analytics (Optional) ─────────────────────────
# Get from PostHog project settings
POSTHOG_API_KEY=phc_your_posthog_key_here
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_SYSTEM_ID=positionedup-squad

# ── NotebookLM MCP (Optional) ──────────────────────────
# Required for zero-hallucination research via Google NotebookLM
# Get from Google OAuth or Google Cloud Console
# GOOGLE_ACCESS_TOKEN=your-google-access-token

# ── Optional Platform Tokens ─────────────────────────────
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════
# SECTION B: Backend API Environment (Vercel / local dev)
# Set these in Vercel dashboard or local apps/api/.env
# ═══════════════════════════════════════════════════════════

# ── Supabase (Required) ─────────────────────────────────
# Get from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# ── LLM Provider Keys ────────────────────────────────────
# Same keys as VPS section — both API and agents need LLM access
# OPENAI_API_KEY=sk-your-openai-api-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Real-time Research (Optional) ─────────────────────────
# Tavily: better search quality. Free tier: 1000 searches/month
# Falls back to DuckDuckGo if not set
# TAVILY_API_KEY=tvly-your-tavily-api-key

# ── Agent Bridge (Required for agent ↔ API communication) ─
# Must match AGENT_API_KEY set on VPS
# AGENT_API_KEY=your-agent-bridge-api-key

# ── OpenClaw Gateway Connection (API → agent runtime) ────
# URL of your VPS gateway (e.g. https://agents.positionedup.com)
OPENCLAW_GATEWAY_URL=https://agents.yourdomain.com
# Must match OPENCLAW_GATEWAY_TOKEN set on VPS
# OPENCLAW_GATEWAY_TOKEN=must-match-token-on-VPS
# Set to true for local dev without VPS (returns demo data)
OPENCLAW_MOCK_MODE=false

# ── PostHog Analytics (Optional) ─────────────────────────
# POSTHOG_API_KEY=phc_your_posthog_key_here
# POSTHOG_HOST=https://us.i.posthog.com

# ── OAuth Integrations (Optional) ────────────────────────
# Google OAuth (for Google Drive, Calendar, etc.)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# Notion OAuth (for Notion integration)
# NOTION_CLIENT_ID=your-notion-client-id
# NOTION_CLIENT_SECRET=your-notion-client-secret
# NOTION_REDIRECT_URI=https://your-api-url.vercel.app/oauth/notion/callback

# ── Cost Governance (Optional, defaults shown) ───────────
# MAX_TOKENS_PER_STEP=32000
# MAX_TOKENS_PER_WORKFLOW=200000
# MAX_WORKFLOWS_PER_USER_PER_DAY=10
# MAX_TOKENS_PER_USER_PER_DAY=500000

# ── Observability (Optional) ─────────────────────────────
# LOG_LEVEL=INFO
