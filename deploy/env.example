# ─────────────────────────────────────────────────────────
# OpenClaw VPS Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────

# ── OpenClaw Gateway ─────────────────────────────────────
# Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── LLM Provider Keys ────────────────────────────────────
# OpenAI (used by Jarvis, Trend Analyzer, Visual Designer, Distributor, Analytics)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic (used by Copywriter for Claude Sonnet)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ── Telegram Bot ──────────────────────────────────────────
# Get from @BotFather on Telegram: /newbot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIjKlMnOpQrStUvWxYz

# Your Telegram user ID (numeric). Get from @userinfobot or gateway logs
TELEGRAM_OWNER_CHAT_ID=123456789

# ── PositionedUp Brain Connection ─────────────────────────
# Agent Bridge API key (must match AGENT_API_KEY in Vercel backend)
AGENT_API_KEY=your-agent-bridge-api-key

# PositionedUp backend URL (your deployed API)
POSITIONEDUP_API_URL=https://your-deployed-api-url.vercel.app

# Your Supabase user ID (for Agent Bridge X-User-Id header)
POSITIONEDUP_USER_ID=your-supabase-user-id

# ── PostHog Analytics (Optional) ─────────────────────────
# Get from PostHog project settings
POSTHOG_API_KEY=phc_your_posthog_key_here
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_SYSTEM_ID=positionedup-squad

# ── Optional Platform Tokens ─────────────────────────────
# FACEBOOK_PAGE_ACCESS_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
