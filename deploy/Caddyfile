# ─────────────────────────────────────────────────────────
# Caddy HTTPS Reverse Proxy — PositionedUp OpenClaw Gateway
# Automatically provisions Let's Encrypt TLS certificates
#
# Usage: Place at /opt/openclaw/Caddyfile on VPS
# ─────────────────────────────────────────────────────────

{
	# Global options
	email {$ACME_EMAIL:admin@positionedup.com}

	# Rate limit ACME requests
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ── OpenClaw Gateway (authenticated) ────────────────────
# Replace YOUR_DOMAIN with your actual domain/subdomain
# e.g., agents.positionedup.com
{$OPENCLAW_DOMAIN:agents.positionedup.com} {
	# TLS is automatic with Caddy

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Rate limiting: 60 requests per minute per IP
	rate_limit {
		zone gateway {
			key {remote_host}
			events 60
			window 1m
		}
	}

	# Proxy to OpenClaw gateway (loopback only)
	reverse_proxy localhost:18789 {
		# Health check
		health_uri /health
		health_interval 30s
		health_timeout 10s

		# Timeouts for long-running agent operations
		transport http {
			dial_timeout 10s
			response_header_timeout 300s
			read_timeout 300s
			write_timeout 300s
		}
	}

	# Access logging
	log {
		output file /var/log/caddy/access.log {
			roll_size 50mb
			roll_keep 5
		}
	}
}

# ── Health check endpoint (no auth, for monitoring) ─────
{$OPENCLAW_DOMAIN:agents.positionedup.com}:8080 {
	respond /health "OK" 200
}
