# ── Docker build context exclusions ──────────────────────
# Only copy what OpenClaw agents need, not the full app

# Exclude frontend and backend app code (deployed on Vercel)
apps/
infra/
docs/

# Exclude dev/build artifacts
node_modules/
.next/
__pycache__/
*.pyc
.pytest_cache/
test-results/
playwright-report/

# Exclude git and IDE
.git/
.cursor/
.vscode/
*.swp

# Exclude env files (injected via docker-compose)
.env
.env.*
!deploy/env.example

# Exclude deploy artifacts (we COPY selectively in Dockerfile)
deploy/

# Exclude large/unnecessary files
*.log
*.tar.gz
